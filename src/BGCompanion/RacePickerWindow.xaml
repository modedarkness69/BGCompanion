<Window x:Class="BGCompanion.RacePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типы этой игры" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Background="#F0141419" BorderBrush="#F2B33D" BorderThickness="1" CornerRadius="10" Padding="16,12">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Click="Cancel_Click" Margin="0"/>
                <TextBlock Text="Какие типы в этой игре?" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}"
                           MouseLeftButtonDown="Drag"/>
            </DockPanel>
            <TextBlock x:Name="Hint" Margin="0,4,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Отметьте 5 типов, которые игра написала в начале матча."/>
            <WrapPanel x:Name="Buttons"/>
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="OkButton" DockPanel.Dock="Right" Content="Готово" Style="{StaticResource AccentButton}" Click="Ok_Click" Margin="0"/>
                <TextBlock x:Name="Counter" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
