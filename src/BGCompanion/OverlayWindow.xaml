<Window x:Class="BGCompanion.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG Companion Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Left="0" Top="0" Width="10" Height="10">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#E0141419"/>
            <Setter Property="BorderBrush" Value="#353545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <!-- выбор героя: сверху по центру -->
        <Border x:Name="HeroPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#E6141419" BorderBrush="#F2B33D" BorderThickness="1" CornerRadius="10" Padding="16,12"
                Visibility="Collapsed">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="HeroScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <StackPanel>
                <TextBlock Text="Выбор героя" FontSize="15" FontWeight="Bold" Foreground="#F2B33D" Margin="0,0,0,6"/>
                <ItemsControl x:Name="HeroItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" Margin="0,2" Foreground="#E8E8EE"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="HeroHint" FontSize="12" Foreground="#9A9AAE" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"/>
            </StackPanel>
        </Border>

        <!-- справа сверху (слева в BG таблица игроков): матч, таверна, соперник -->
        <StackPanel x:Name="RightStack" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,24,0" Width="340">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="GameScale" ScaleX="1" ScaleY="1"/>
            </StackPanel.LayoutTransform>

            <Border x:Name="GamePanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="GameTitle" FontSize="14" FontWeight="SemiBold" Foreground="#F2B33D"/>
                    <TextBlock x:Name="GameLine" FontSize="13" Foreground="#E8E8EE" Margin="0,2,0,0"/>
                    <TextBlock x:Name="RacesLine" FontSize="12" Foreground="#9A9AAE" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GameTip" FontSize="12" Foreground="#5BD37A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="CompsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Сборки для этого лобби" FontSize="13" FontWeight="SemiBold" Foreground="#F2B33D" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="CompItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{Binding Color}"/>
                                    <TextBlock Text="{Binding Why}" FontSize="11" Foreground="#9A9AAE" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="ShopPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ShopHeader" Text="Таверна" FontSize="13" FontWeight="SemiBold" Foreground="#F2B33D" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="ShopItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Why}" FontSize="11" Foreground="#9A9AAE" TextWrapping="Wrap"
                                               Visibility="{Binding WhyVisibility}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="OppPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="OppTitle" FontSize="13" FontWeight="SemiBold" Foreground="#E8615B" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OppBoard" FontSize="12" Foreground="#E8E8EE" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Credit" Text="BG Companion · made by modedarkness" FontSize="10" Foreground="#806A6A7E"
                       HorizontalAlignment="Right" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
