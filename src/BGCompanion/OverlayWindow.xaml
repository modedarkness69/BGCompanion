<Window x:Class="BGCompanion.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG Companion Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Left="0" Top="0" Width="10" Height="10">
    <Grid x:Name="Root">
        <!-- выбор героя: сверху по центру -->
        <Border x:Name="HeroPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#E6141419" BorderBrush="#F2B33D" BorderThickness="1" CornerRadius="10" Padding="16,12"
                Visibility="Collapsed">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="HeroScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <StackPanel>
                <TextBlock Text="Выбор героя" FontSize="15" FontWeight="Bold" Foreground="#F2B33D" Margin="0,0,0,6"/>
                <ItemsControl x:Name="HeroItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" Margin="0,2" Foreground="#E8E8EE"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="HeroHint" FontSize="12" Foreground="#9A9AAE" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"/>
            </StackPanel>
        </Border>

        <!-- матч: справа сверху (слева в BG таблица игроков) -->
        <Border x:Name="GamePanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,24,0"
                Background="#D9141419" BorderBrush="#353545" BorderThickness="1" CornerRadius="8" Padding="12,8"
                Visibility="Collapsed" MaxWidth="320">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="GameScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <StackPanel>
                <TextBlock x:Name="GameTitle" FontSize="14" FontWeight="SemiBold" Foreground="#F2B33D"/>
                <TextBlock x:Name="GameLine" FontSize="13" Foreground="#E8E8EE" Margin="0,2,0,0"/>
                <TextBlock x:Name="GameTip" FontSize="12" Foreground="#5BD37A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="BG Companion · made by modedarkness" FontSize="10" Foreground="#6A6A7E" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
