<Window x:Class="BGCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG Companion" Width="980" Height="640" MinWidth="820" MinHeight="520"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- шапка -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="18,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BG Companion" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="made by modedarkness" Foreground="{StaticResource Muted}" Margin="10,6,0,0"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="10,6,0,0"/>
                </StackPanel>
                <Border x:Name="UpdateBanner" DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="Collapsed"
                        Background="#33F2B33D" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Обновить" Style="{StaticResource AccentButton}" Click="Update_Click" Margin="0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- строка статуса -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="18,6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TabControl Margin="12,8,12,8">
            <!-- ОБЗОР -->
            <TabItem Header="Обзор">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Текущий матч" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="GameHero" FontSize="18" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GameInfo" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GameTip" Margin="0,10,0,0" Foreground="{StaticResource Good}" TextWrapping="Wrap"/>
                            <TextBlock Text="Предложенные герои" FontWeight="SemiBold" Margin="0,16,0,6"/>
                            <ItemsControl x:Name="OfferList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Состояние" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="StHs" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock x:Name="StLog" TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StCards" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock x:Name="StCommunity" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock x:Name="StGames" TextWrapping="Wrap" Margin="0,2"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="DemoButton" Content="Демо: проиграть прошлую игру" Style="{StaticResource AccentButton}"
                                        Click="Demo_Click" Margin="0,0,8,8"
                                        ToolTip="Проигрывает вашу записанную игру, чтобы показать оверлей. В статистику не записывается."/>
                                <Button Content="Импорт старых логов" Click="Import_Click" Margin="0,0,8,8"/>
                                <Button Content="Обновить базу" Click="Sync_Click" Margin="0,0,8,8"/>
                                <Button Content="Папка данных" Click="DataDir_Click" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ГЕРОИ -->
            <TabItem Header="Герои">
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Личная статистика по вашим играм. «Сообщество» — общая база проекта, скачивается при запуске."/>
                    <DataGrid x:Name="HeroGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Герой" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Предлагали" Binding="{Binding Offered}" Width="*"/>
                            <DataGridTextColumn Header="Брали" Binding="{Binding Picked}" Width="*"/>
                            <DataGridTextColumn Header="% выбора" Binding="{Binding PickRate}" Width="*"/>
                            <DataGridTextColumn Header="Игр" Binding="{Binding Games}" Width="*"/>
                            <DataGridTextColumn Header="Ср. место" Binding="{Binding AvgPlace}" Width="*"/>
                            <DataGridTextColumn Header="Топ-4" Binding="{Binding Top4}" Width="*"/>
                            <DataGridTextColumn Header="Победы" Binding="{Binding Wins}" Width="*"/>
                            <DataGridTextColumn Header="Сообщество" Binding="{Binding Community}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ИСТОРИЯ -->
            <TabItem Header="История">
                <DataGrid x:Name="HistoryGrid" Margin="0,12,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="Герой" Binding="{Binding Hero}" Width="2*"/>
                        <DataGridTextColumn Header="Место" Binding="{Binding Place}" Width="70"/>
                        <DataGridTextColumn Header="Таверна" Binding="{Binding Tier}" Width="70"/>
                        <DataGridTextColumn Header="Ходов" Binding="{Binding Turns}" Width="70"/>
                        <DataGridTextColumn Header="Повышения" Binding="{Binding Curve}" Width="2*"/>
                        <DataGridTextColumn Header="Предлагали" Binding="{Binding Offered}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- НАСТРОЙКИ -->
            <TabItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Оверлей поверх игры" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="OptOverlay" Content="Показывать оверлей" Click="Option_Changed"/>
                        <CheckBox x:Name="OptHeroPanel" Content="Подсказка при выборе героя" Click="Option_Changed"/>
                        <CheckBox x:Name="OptTips" Content="Подсказки по темпу таверны" Click="Option_Changed"/>
                        <TextBlock Text="Прозрачность оверлея" Margin="0,12,0,2" Foreground="{StaticResource Muted}"/>
                        <Slider x:Name="OptOpacity" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                        <TextBlock Text="Размер оверлея" Margin="0,8,0,2" Foreground="{StaticResource Muted}"/>
                        <Slider x:Name="OptScale" Minimum="0.6" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>

                        <TextBlock Text="Hearthstone" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Выбрать…" Click="PickDir_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="OptDir" IsReadOnly="True" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                                     BorderBrush="{StaticResource Line}" Padding="6,4"/>
                        </DockPanel>

                        <TextBlock Text="Прочее" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <CheckBox x:Name="OptUpdates" Content="Проверять обновления при запуске" Click="Option_Changed"/>
                        <CheckBox x:Name="OptMinimized" Content="Запускать свёрнутым" Click="Option_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- О ПРОГРАММЕ -->
            <TabItem Header="О программе">
                <StackPanel Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="BG Companion" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="made by modedarkness" Foreground="{StaticResource Accent}" Margin="0,2,0,10"/>
                    <TextBlock x:Name="AboutVersion" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14"
                               Text="Помощник для Hearthstone Battlegrounds. Читает только лог-файлы игры, в память и файлы игры не вмешивается. База карт — HearthstoneJSON. Статистика — ваши собственные игры и общая база проекта."/>
                    <WrapPanel>
                        <Button Content="Проверить обновления" Click="CheckUpdates_Click" Margin="0,0,8,8"/>
                        <Button Content="Страница на GitHub" Click="GitHub_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
